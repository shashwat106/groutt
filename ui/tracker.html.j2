<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ workflow|title }} tracker · {{ biz }}</title>
<style>
  :root{--bg:#f4eee5;--card:#fffdf9;--ink:#2a211b;--muted:#7b6d61;--line:#e6dccf;--tan:#9a5b2e}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}
  header{padding:28px 32px 8px}
  h1{font-family:Georgia,serif;font-weight:600;font-size:28px;margin:0}
  .brand{color:var(--tan);font-weight:700;letter-spacing:.04em;font-size:12px}
  .sub{color:var(--muted);font-size:13px}
  .board{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,1fr);gap:14px;padding:16px 32px 40px;overflow-x:auto}
  .col{background:#ece3d6;border-radius:14px;padding:12px}
  .col h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:2px 4px 10px;display:flex;justify-content:space-between}
  .c{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px}
  .c b{display:block;font-size:14px}.c p{margin:4px 0;font-size:13px}.c small{color:var(--muted)}
  @media (max-width:700px){.board{padding:16px}header{padding:20px 16px 4px}}
</style>
</head>
<body>
<header>
  <div class="brand">GROUT</div>
  <h1>{{ workflow|title }}</h1>
  <div class="sub">{{ biz }} · generated {{ generated }}</div>
</header>
<div class="board">
{% for col in cols %}
  {% set items = cards|selectattr('col','equalto',col)|list %}
  <section class="col"><h2><span>{{ col|replace('_',' ') }}</span><span>{{ items|length }}</span></h2>
  {% for c in items %}<div class="c"><b>{{ c.title }}</b><p>{{ c.body }}</p><small>{{ c.meta }}</small></div>{% endfor %}
  </section>
{% endfor %}
</div>
</body>
</html>
