# Copy to .env and fill in. Everything is optional for the local demo.

# Local demo (default): SQLite file in ./data
# DATABASE_URL=sqlite:///data/industryos.db

# Supabase (production): Project Settings -> Database -> Connection string (URI)
# DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# Role for this connection: owner | accountant | manager | viewer (NOT real auth, demo only)
INDUSTRYOS_ROLE=owner
INDUSTRYOS_BUSINESS_ID=1

# Pin "today" for a rehearsed demo (YYYY-MM-DD). Leave empty to use the real date.
# INDUSTRYOS_TODAY=2026-11-23

# 1 = open dashboards and approval pages in the browser automatically
INDUSTRYOS_OPEN_BROWSER=1
